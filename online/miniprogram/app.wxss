page { background:#faf5e9; color:#283748; font-family: sans-serif; } .page { padding:32rpx; } .title { font-size:48rpx; font-weight:bold; margin:24rpx 0; } .muted { color:#727d73; font-size:26rpx; line-height:1.8; } .card { background:#fffcf3; border:3rpx solid #344455; border-radius:24rpx 19rpx 27rpx 17rpx; padding:28rpx; margin:24rpx 0; box-shadow:5rpx 6rpx 0 #e4ddcf; } button { background:#b9dcc3; border:3rpx solid #344455; border-radius:22rpx 17rpx 24rpx 18rpx; margin:20rpx 0; font-size:30rpx; } button::after { border:0; } button[disabled] { opacity:.5; } input { padding:20rpx; background:#fffdf7; border-bottom:2rpx dashed #87938a; } .error { color:#a34031; font-size:26rpx; }
