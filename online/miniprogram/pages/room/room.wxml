<view class="page"><view class="title">好友飞行棋</view><view class="muted">{{room.status === 'waiting' ? '等待四位好友到齐' : statusText}} · {{connected ? '已同步' : '正在重连'}}</view><view class="card seats"><view wx:for="{{seats}}" wx:key="index" class="seat" style="border-color:{{item.colorHex}}"><view>{{item.name}}{{index === room.seat ? '（你）' : ''}}</view><view class="muted">{{item.label}}</view></view></view><block wx:if="{{room.status === 'waiting'}}"><button open-type="share" disabled="{{busy}}">点击邀请好友（{{count}} / 4）</button><button bindtap="ready" disabled="{{busy}}" loading="{{busy}}">{{myReady ? '取消准备' : '我准备好了'}}</button><button wx:if="{{room.isHost}}" bindtap="start" disabled="{{busy || !allReady}}">四人到齐，开始游戏</button><view class="muted" bindtap="copyRoom">房间码：{{room.id}}（点击复制）</view></block><canvas type="2d" id="board" class="board" bindtouchend="boardTap"/><block wx:if="{{room.status === 'playing'}}"><view class="turn">{{statusText}} · 剩余 {{seconds}} 秒</view><view class="dice">{{rolling ? '骰子滚动中…' : '骰子：' + (room.game.die || '等待投掷')}}</view><button bindtap="roll" disabled="{{busy || rolling || !myTurn || room.game.phase !== 'roll'}}">{{myTurn ? '掷骰子' : '等待好友掷骰子'}}</button><view class="choices"><button wx:for="{{legal}}" wx:key="*this" bindtap="move" data-piece="{{item}}" disabled="{{busy || rolling}}">飞机 {{item + 1}}</button></view><button wx:if="{{seconds === 0}}" bindtap="timeout" disabled="{{busy}}">跳过超时回合</button></block><button wx:if="{{room.status === 'done' && room.isHost}}" bindtap="rematch" disabled="{{busy}}">再来一局</button><view class="error">{{error}}</view><button wx:if="{{!connected}}" bindtap="reconnect">重新连接房间</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试未确认的操作</button><view class="muted">{{rulesSummary}} · 6 点连掷
每次操作限时60秒 · 暂离后可返回原座位</view><button bindtap="leave" disabled="{{busy}}">{{room.status === 'playing' ? '暂时离开（保留座位）' : '退出房间'}}</button></view>
